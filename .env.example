# ─── EduM environment ───────────────────────────────────────────
# Copy to .env (repo root, used by docker-compose) and to apps/api/.env
# for bare-metal local dev. No real secrets are committed anywhere.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edum
# Bare-metal dev connection string (docker-compose builds its own):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edum?schema=public"

# JWT — CHANGE BOTH IN ANY REAL DEPLOYMENT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s

# Redis (rate limiting / queues)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO in docker-compose).
# If unreachable in dev, the API falls back to local ./uploads storage.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=edum

# Notification providers: 'mock' logs deliveries and stores rows without
# any external API key. Swap for real providers later without code changes.
NOTIFY_EMAIL_PROVIDER=mock
NOTIFY_SMS_PROVIDER=mock

# Payment gateway: 'mock' = sandbox auto-approve checkout (swappable interface).
PAYMENT_GATEWAY=mock

# API port
PORT=4000
