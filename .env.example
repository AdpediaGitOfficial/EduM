# ─── EduM environment ───────────────────────────────────────────
# Copy to apps/api/.env — the API loads it via dotenv (@nestjs/config).
# The web app needs no env file (API_INTERNAL_URL is set by PM2/ecosystem).
# No real secrets are committed anywhere in this repository.

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edum?schema=public"

# JWT — CHANGE BOTH IN ANY REAL DEPLOYMENT (openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s

# Redis (rate limiting / queues)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (any S3/MinIO endpoint).
# If unreachable, the API automatically falls back to local ./uploads storage.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=edum

# Notification providers: 'mock' logs deliveries and stores rows without
# any external API key. Swap for real providers later without code changes.
NOTIFY_EMAIL_PROVIDER=mock
NOTIFY_SMS_PROVIDER=mock

# Payment gateway: 'mock' = sandbox auto-approve checkout (swappable interface).
PAYMENT_GATEWAY=mock

# API port (Nginx proxies /api → this port; web runs on 3000)
PORT=4000
